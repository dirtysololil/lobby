{
  "name": "lobby",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lobby/shared build && pnpm --filter @lobby/config build && pnpm --parallel --filter @lobby/shared --filter @lobby/config --filter @lobby/api --filter @lobby/web dev",
    "dev:worker": "pnpm --filter @lobby/api dev:worker",
    "build": "node ./scripts/build.mjs",
    "postinstall": "node ./scripts/prisma-cli.mjs generate --schema prisma/schema.prisma",
    "start:web": "node apps/web/scripts/run-next.mjs start",
    "start:api": "pnpm --filter @lobby/api start:prod",
    "start:worker": "pnpm --filter @lobby/api start:worker",
    "desktop:dev": "corepack pnpm --filter @lobby/desktop dev",
    "desktop:check": "corepack pnpm --filter @lobby/desktop check",
    "desktop:pack": "corepack pnpm --filter @lobby/desktop pack",
    "desktop:dist": "corepack pnpm --filter @lobby/desktop dist",
    "desktop:dist:installer": "corepack pnpm --filter @lobby/desktop dist:installer",
    "lint": "pnpm --filter @lobby/api lint && pnpm --filter @lobby/web lint",
    "typecheck": "pnpm --filter @lobby/shared build && pnpm --filter @lobby/config build && pnpm --filter @lobby/api exec tsc --noEmit && pnpm --filter @lobby/web exec tsc --noEmit",
    "prisma:generate": "node ./scripts/prisma-cli.mjs generate --schema prisma/schema.prisma",
    "prisma:validate": "node ./scripts/prisma-cli.mjs validate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "node ./scripts/prisma-cli.mjs migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node ./scripts/prisma-cli.mjs migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:resolve:baseline": "node ./scripts/prisma-cli.mjs migrate resolve --applied 20260402170000_mysql_baseline --schema prisma/schema.prisma",
    "prisma:studio": "node ./scripts/prisma-cli.mjs studio --schema prisma/schema.prisma",
    "db:seed": "pnpm exec tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  }
}
